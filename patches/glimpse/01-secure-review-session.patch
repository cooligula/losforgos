+                MediaStore.ACTION_REVIEW_SECURE -> {
+                    // Pixel Camera passes only the last photo as data, and lists every photo of
+                    // the secure session in an extra. Show all of them, starting at the last one.
+                    val shown = mediaItems.filterIsInstance<Media>()
+                    ParsedIntent.SecureReviewIntent(
