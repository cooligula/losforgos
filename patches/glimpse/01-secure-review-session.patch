@@ -271,0 +281,19 @@
+    /**
+     * Media of the camera's secure session, from the ids the camera puts in the intent.
+     * Oldest first. Ids that cannot be read are skipped.
+     */
+    private suspend fun secureSessionMedias(intent: Intent) = buildList<Media> {
+        val ids = intent.extras?.getLongArray(EXTRA_SECURE_MODE_IDS) ?: return@buildList
+        ids.sorted().forEach { id ->
+            listOf(
+                MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
+                MediaStore.Video.Media.EXTERNAL_CONTENT_URI,
+            ).firstNotNullOfOrNull { base ->
+                when (val status = mediaRepository.media(ContentUris.withAppendedId(base, id)).first()) {
+                    is RequestStatus.Success -> status.data
+                    else -> null
+                }
+            }?.let { add(it) }
+        }
+    }
