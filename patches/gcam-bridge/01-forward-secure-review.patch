+    private fun isSecureReview(received: Intent): Boolean {
+        return received.action == ACTION_REVIEW_SECURE || received.action == ACTION_PHOTOS_REVIEW_SECURE
+    }
+
+    /**
+     * Hands a secure review (the camera's gallery button on the lock screen) to a gallery app unchanged:
+     * same action, data, clip data and extras, so the gallery can show exactly the photos of this
+     * secure session on top of the lock screen. Returns false when no gallery accepts it.
+     */
+    private fun forwardSecureReview(received: Intent): Boolean {
+        val forward = Intent(received).apply {
+            action = ACTION_REVIEW_SECURE
+            setPackage(null)
+            component = null
+            flags = Intent.FLAG_GRANT_READ_URI_PERMISSION
+        }
+
+        val candidates = packageManager
+            .queryIntentActivities(forward, PackageManager.MATCH_DEFAULT_ONLY)
+            .map { it.activityInfo }
+            .filter { it.packageName != packageName && it.exported }
+        val target = candidates.firstOrNull { it.packageName in PREFERRED_GALLERIES } ?: candidates.firstOrNull()
+
+        if (target == null) {
+            Log.w(javaClass.simpleName, "No gallery handles ACTION_REVIEW_SECURE, falling back to a plain view")
+            return false
+        }
+
+        forward.component = ComponentName(target.packageName, target.name)
+        return try {
+            startActivity(forward)
+            Log.d(javaClass.simpleName, "Forwarded secure review to ${forward.component}")
+            true
+        } catch (e: Exception) {
+            Log.w(javaClass.simpleName, "Forwarding secure review failed", e)
+            false
+        }
+    }
+
+    private companion object {
+        const val ACTION_REVIEW_SECURE = "android.provider.action.REVIEW_SECURE"
+        const val ACTION_PHOTOS_REVIEW_SECURE = "com.google.android.apps.photos.mars.api.ACTION_REVIEW_SECURE"
+
+        val PREFERRED_GALLERIES = setOf("org.losforgos.glimpse", "org.lineageos.glimpse")
+    }
